# Xcode
build/
DerivedData/
*.xcuserstate
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
xcuserdata/
*.xcscmblueprint
*.xcuserdatad

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
# `Icon?` above (the standard macOS-template pattern for the custom-folder-icon resource
# file, literally "Icon" + carriage return) collides with any real directory named "icons"
# under core.ignorecase — `?` matches the 's', so it silently swallowed assets/icons/.
!assets/icons/
._*

# IDE
*.swp
*~
.idea/

# Agent harness local state (oh-my-claudecode / OMC) — never commit
.omc/

# Env / secrets
*.pem
.env
.env.*

# xcodegen (keep project.yml; regenerate .xcodeproj if needed)
# Uncomment if you prefer not to commit the generated project:
# *.xcodeproj/
# *.xcworkspace/
